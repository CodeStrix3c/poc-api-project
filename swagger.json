    "/api/v1/media": {
      "post": {
        "tags": [
          "Media"
        ],
        "summary": "Upload media (image/video) for a question or answer",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "type",
                  "url"
                ],
                "properties": {
                  "questionId": {
                    "type": "integer",
                    "description": "ID of question (required if no answerId)"
                  },
                  "answerId": {
                    "type": "integer",
                    "description": "ID of answer (required if no questionId)"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "image",
                      "video",
                      "embed"
                    ],
                    "description": "Type of media"
                  },
                  "url": {
                    "type": "string",
                    "description": "Direct URL to media file"
                  },
                  "thumbnail": {
                    "type": "string",
                    "description": "URL to thumbnail image"
                  },
                  "altText": {
                    "type": "string",
                    "description": "Alternative text for accessibility"
                  },
                  "width": {
                    "type": "integer",
                    "description": "Media width in pixels"
                  },
                  "height": {
                    "type": "integer",
                    "description": "Media height in pixels"
                  },
                  "duration": {
                    "type": "number",
                    "description": "Duration in seconds (for videos)"
                  },
                  "platform": {
                    "type": "string",
                    "description": "Platform source (e.g., youtube, imgur)"
                  }
                }
              },
              "example": {
                "answerId": 1,
                "type": "image",
                "url": "https://example.com/screenshot.png",
                "altText": "FastAPI async file upload screenshot",
                "width": 800,
                "height": 600
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Media uploaded"
          }
        }
      }
    },
