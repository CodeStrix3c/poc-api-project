              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "questionId": {
                          "type": "integer"
                        },
                        "totalViews": {
                          "type": "integer"
                        },
                        "uniqueViewers": {
                          "type": "integer"
                        },
                        "viewers": {
                          "type": "array",
