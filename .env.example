# SQL Server Connection Configuration
# Copy this file to .env and update with your values

# Using Windows Authentication (Integrated Security)
DB_SERVER=localhost
DB_NAME=discussion_forum
DB_INTEGRATED_SECURITY=true

# Alternative: SQL Server Authentication (Username/Password)
# DB_SERVER=localhost
# DB_USER=sa
# DB_PASSWORD=yourPassword
# DB_INTEGRATED_SECURITY=false

# SQL Server Port (default: 1433)
DB_PORT=1433

# Connection Options
DB_ENCRYPT=false
DB_TRUST_CERTIFICATE=true
DB_POOLING=false
DB_MARS=false

# Optional Settings
# DB_TIMEOUT=0
# DEBUG=true
